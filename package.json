{
  "name": "cartell",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "env:dev": "node scripts/use-env.js dev",
    "env:test": "node scripts/use-env.js test",
    "env:beta": "node scripts/use-env.js beta",
    "env:live": "node scripts/use-env.js live",
    "env:simulator": "node scripts/use-env.js simulator",
    "android": "react-native run-android --mode standardDebug --no-packager",
    "android:rn": "react-native run-android --mode rnDebug --appId com.iwatllc.cartell.rn --no-packager",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{js,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "later": "node scripts/later.js"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
