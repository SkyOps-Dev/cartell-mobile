# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# The QR scanner's GoogleMLKit/BarcodeScanning 9.0.0 needs iOS 15.5 (Flutter's floor is 15.0, React
# Native 0.87's 15.1). Runner's deployment target in the pbxproj carries the same value.
ios_floor = '15.5'
platform :ios, ios_floor
prepare_react_native_project!

# The Firebase iOS SDK (@react-native-firebase 27.1.0: Firebase 13.1.1) must be built as
# frameworks; React Native supports them linked statically, and RNFB's own pods follow. Flutter's
# Podfile builds every pod as a framework too (use_frameworks!). Written, not yet built: no Mac
# (PARITY_ISSUES).
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'Cartell' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
